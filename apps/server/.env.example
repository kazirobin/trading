# ---- server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# ---- database ----
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/tradevix?retryWrites=true&w=majority"
MONGODB_DB=tradevix

# ---- auth ----
JWT_ACCESS_SECRET=replace_with_random_long_secret
JWT_REFRESH_SECRET=replace_with_random_long_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- app ----
ADMIN_EMAILS=admin@tradevix.local
FEE_ACCOUNT_EMAIL=fees@tradevix.local
